# Resend — replace re_xxxxxxxxx with your API key from https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxx

# Until a domain is verified in Resend, onboarding@resend.dev only delivers to your Resend account email.
# After verifying koenigentertainment.com (or your film domain), switch to e.g.:
# CONTACT_FROM_EMAIL=The Story of ShipRocked <noreply@koenigentertainment.com>
CONTACT_FROM_EMAIL=The Story of ShipRocked <onboarding@resend.dev>

# Where contact-form messages are delivered (requires verified domain unless using test mode to your own inbox)
CONTACT_TO_EMAIL=storyofshiprocked@koenigentertainment.com
